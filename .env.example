# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/issue_tracker

# Gemini API (free tier via Google AI Studio: https://aistudio.google.com/apikey)
# Note: Free-tier prompts may be used by Google to improve products — use test/non-private data only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Local embeddings (runs locally with no rate limits)
# Option A (default): sentence-transformers model name (e.g., all-MiniLM-L6-v2, 384 dims)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Option B: If you prefer Ollama instead of sentence-transformers, uncomment below:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
